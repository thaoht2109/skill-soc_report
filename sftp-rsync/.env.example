# Sao chép thành .env rồi: chmod 600 .env
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=tai_khoan
# Đặt trong nháy đơn để ký tự đặc biệt ($, !, khoảng trắng...) không bị shell diễn giải.
SFTP_PASS='mat_khau'
# Thư mục nguồn trên server (không bị xóa/sửa) và thư mục đích trên máy này.
REMOTE_DIR=/data
LOCAL_DIR=/srv/backup/data

# Nhiều thư mục: bỏ hai dòng REMOTE_DIR/LOCAL_DIR ở trên và khai mỗi cặp một dòng "nguồn|đích".
# SYNC_DIRS=(
#   "/data|/srv/backup/data"
#   "/logs|/srv/backup/logs"
# )
